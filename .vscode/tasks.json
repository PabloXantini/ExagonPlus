                "${workspaceFolder}/src/PEngine/core/platform/Instance.cpp",
                "${workspaceFolder}/src/PEngine/core/graphics/Instance.cpp",
                "${workspaceFolder}/src/PEngine/core/graphics/GL/glad.c",
